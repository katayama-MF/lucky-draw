{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/Button/**",
              "components/content/**",
              "components/display/**",
              "components/media/**",
              "ui_kits/schooltop/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:M PLUS Rounded 1c|Baloo 2))/i]",
        "message": "Font not provided by the design system. Available: M PLUS Rounded 1c, Baloo 2."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|outline|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, outline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|method|party|eiken|mint|campaign|solid)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'method' | 'party' | 'eiken' | 'mint' | 'campaign' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|course|icon|note|fullWidth|as|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, course, icon, note, fullWidth, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|course|soft|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'course' | 'soft' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='course'] > Literal[value!=/^(?:method|party|eiken)$/]",
        "message": "<Button> course must be one of 'method' | 'party' | 'eiken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|course|tint|pad|radius|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, course, tint, pad, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='course'] > Literal[value!=/^(?:method|party|eiken|mint)$/]",
        "message": "<Card> course must be one of 'method' | 'party' | 'eiken' | 'mint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComboFormulaItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:emoji|label|freq|key|ref|className|style|children)$/]",
        "message": "<ComboFormulaItem> doesn't accept that prop. Declared props: emoji, label, freq."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclaimer'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|style|key|ref|className|style|children)$/]",
        "message": "<Disclaimer> doesn't accept that prop. Declared props: children, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclaimer'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Disclaimer> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:q|children|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: q, children, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|tone|circle|minHeight|style|key|ref|className|style|children)$/]",
        "message": "<ImagePlaceholder> doesn't accept that prop. Declared props: label, hint, tone, circle, minHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlaceholder'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|method|party|eiken)$/]",
        "message": "<ImagePlaceholder> tone must be one of 'neutral' | 'method' | 'party' | 'eiken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|em|lead|align|playful|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, em, lead, align, playful, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeechBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<SpeechBubble> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeechBubble'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|pink|mint|white)$/]",
        "message": "<SpeechBubble> tone must be one of 'yellow' | 'pink' | 'mint' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|desc|featured|style|key|ref|className|style|children)$/]",
        "message": "<StatBadge> doesn't accept that prop. Declared props: label, value, unit, desc, featured, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:badge|badgeTone|who|children|style|key|ref|className|style|children)$/]",
        "message": "<VoiceCard> doesn't accept that prop. Declared props: badge, badgeTone, who, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceCard'] > JSXAttribute[name.name='badgeTone'] > Literal[value!=/^(?:method|party|eiken|parent)$/]",
        "message": "<VoiceCard> badgeTone must be one of 'method' | 'party' | 'eiken' | 'parent'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
